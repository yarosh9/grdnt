  "hasPart": [
    {
      "@type": "ItemList",
      "name": "Klüver Visual Form Constants & Turing Patterns",
      "description": "Декомпозиция 8 зрительных структур с описанием математического механизма Тьюринга/Бреслова (реакция-диффузия Возбуждающих/Тормозящих нейронов) и аффордансов.",
      "itemListElement": [
        {
          "@type": "DefinedTerm",
          "name": "Горизонтальные линии",
          "termCode": "HORIZONTAL_LINES",
          "description": "«Где я?»: Базовая линия горизонта. Панорамное сканирование пространства. Ответ мозга на гравитацию и определение стабильной плоскости опоры.",
          "affordance": "Определение пространственной ориентации и опоры",
          "neuralMechanism": "Сканирование горизонтальной оси, обработка сигналов гравитационной ориентации в V1",
          "reactionDiffusion": "Параллельные полосы нейронной активности, возникающие при анизотропной пространственной диффузии сигналов вдоль горизонтальной оси коры",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_horizontal.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Вертикальные линии",
          "termCode": "VERTICAL_LINES",
          "description": "«Ориентир»: Доминанты (деревья, стены, фигуры). Маркеры препятствий или укрытий в пространстве, заставляющие взгляд остановиться и сориентироваться в глубине.",
          "affordance": "Идентификация препятствий, укрытий и вертикальных ориентиров глубины",
          "neuralMechanism": "Детекция вертикальных ориентационных колонок V1",
          "reactionDiffusion": "Полосы активности при изменении коэффициента диффузии локального торможения вдоль вертикально-ориентированных гиперколонок",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_vertical.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Прямая решетка / Квадратная сетка",
          "termCode": "SQUARE_LATTICE",
          "description": "«Поиск аффорданса»: Ортогональное картирование. Мозг накладывает сетку на хаос ландшафта для математического вычисления физических возможностей (проходимость, стабильность, сепарация объекта от фона).",
          "affordance": "Вычисление проходимости пространства, стабильности зон и сепарация объектов",
          "neuralMechanism": "Ортогональная пространственно-частотная фильтрация",
          "reactionDiffusion": "Интерференция двух перпендикулярных полосчатых мод Тьюринга (двумерные стоячие волны Возбуждения/Торможения)",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_square_lattice.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Косая решетка",
          "termCode": "OBLIQUE_LATTICE",
          "description": "Шаг к триангуляции и уточнению деталей пространственной структуры.",
          "affordance": "Триангуляция и адаптивная оценка диагональных траекторий",
          "neuralMechanism": "Диагонально-ориентированные рецептивные поля зрительной коры",
          "reactionDiffusion": "Смещение фазы реакционно-диффузной неустойчивости под углом к гиперколонкам V1",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_oblique_lattice.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Шахматная доска",
          "termCode": "CHECKERBOARD",
          "description": "Контрастная дискретизация поля восприятия, чередование фаз активности зрительных стимулов.",
          "affordance": "Выделение границ локального контраста и фиксация аттракторов внимания",
          "neuralMechanism": "High-contrast ON/OFF центр-окружение реагирование рецептивных полей",
          "reactionDiffusion": "Дискретная фазовая инверсия активности возбуждающих (E) и тормозящих (I) нейронных ансамблей",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_checkerboard.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Соты / Шестиугольная сетка",
          "termCode": "HONEYCOMB",
          "description": "«Уточнение деталей»: Шестиугольные структуры — наиболее энергоэффективная схема упаковки информации в природе. Переключение мозга в режим микрокартирования текстуры.",
          "affordance": "Микрокартирование текстуры, оптимальная пространственная упаковка информации",
          "neuralMechanism": "Core-сети Grid-нейронов (сетчатых нейронов) навигационной системы мозга",
          "reactionDiffusion": "Классическая гексагональная реакционно-диффузная мода Тьюринга (гексагональная самоорганизация аттракторов активности)",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_honeycomb.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Туннель / Воронка / Спираль / Паутина",
          "termCode": "TUNNEL_COBWEB",
          "description": "«Погружение»: Классическая константа ухода от внешней реальности. При потере внешних стимулов волны возбуждения двигаются концентрически от периферии к центру (фовеа). Логарифмическое отображение x=ln(r), y=theta переводит параллельные полосы в V1 в концентрические туннели и спирали в поле зрения.",
          "affordance": "Фазовый переход восприятия, отключение дневного интерфейса, сдвиг фокуса в глубину",
          "neuralMechanism": "Концентрические автоволны в V1 и логарифмическая конформная трансформация (сетчатка -> кора)",
          "reactionDiffusion": "Логарифмически преобразованные плоские волны активности Тьюринга при потере устойчивости состояния покоя в V1",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_tunnel.svg"
        },
        {
          "@type": "DefinedTerm",
          "name": "Филигрань",
          "termCode": "FILIGREE",
          "description": "Тонкодисперсная фрактальная детализация пространственного шума и микрорельефа.",
          "affordance": "Выявление микротекстурных инвариантов и фрактальных закономерностей",
          "neuralMechanism": "Высокочастотные гармоники пространственного спектра V1",
          "reactionDiffusion": "Высокочастотная фрактальная турбулентность реакционно-диффузного поля на микро-уровне гиперколонок",
          "image": "https://raw.githubusercontent.com/yarosh9/grdnt/main/svg/Kluver_formConstant_filigree.svg"
        }
      ]
    }
  ]
